# Copy this file to .env and replace the placeholder locally.
# Never commit the real .env file.
LEGAL_RAG_LLM_API_KEY=replace-with-provider-key

# Comma-separated browser origins. Do not use * in production.
LEGAL_RAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LEGAL_RAG_LOG_LEVEL=INFO
LEGAL_RAG_MAX_CONCURRENT_INFERENCE=1
